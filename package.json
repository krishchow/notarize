{
  "name": "notarize-mcp",
  "version": "0.2.0",
  "description": "Local stdio MCP server + skill for Apple code signing, notarization, certificates, provisioning, entitlements, Gatekeeper debugging, TestFlight and App Store Connect.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "notarize-mcp": "dist/notarize-mcp.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/notarize-mcp.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:recorded": "vitest run test/recorded.test.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "mcp",
    "apple",
    "codesign",
    "notarization",
    "notarytool",
    "app-store-connect",
    "testflight",
    "provisioning",
    "entitlements",
    "gatekeeper"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/krishchow/notarize.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/node": "^26.6.4",
    "jose": "^6.2.12",
    "plist": "^5.0.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
